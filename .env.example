# ─────────────────────────────────────────────────────────────
# ament — environment variables
# Copy this file to .env (or .env.local) and fill in every value.
# NEVER commit .env or .env.local to git.
# ─────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────
# Your Neon (neon.tech) or Supabase connection string.
# In Neon: Project → Connection Details → "Connection string"
# Use the POOLED connection string for DATABASE_URL (faster),
# and the DIRECT (non-pooled) string for DIRECT_URL (migrations).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── Authentication ────────────────────────────────────────────
# Generate a random secret: run `openssl rand -base64 32` in your terminal.
AUTH_SECRET="your-random-32-char-secret-here"

# The URL your app is running at. In development: http://localhost:3000
# In production: https://your-app.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# ── Email (for magic-link login) ──────────────────────────────
# Resend.com — free tier is generous. Sign up, create an API key.
RESEND_API_KEY="re_your_resend_api_key"
# The email address magic links are sent FROM. Must be a verified domain in Resend.
EMAIL_FROM="noreply@yourorganisation.com"

# ── Anthropic (AI synthesis — Mirror, Seam, Essay, Inheritance) ──
# Get your key at console.anthropic.com → API Keys.
# This is the main ongoing cost (~$0.003 per Mirror query, ~$0.05 per Essay).
ANTHROPIC_API_KEY="sk-ant-your-key-here"
# Which Claude model to use. Change here to upgrade without touching code.
# Current recommended model: claude-sonnet-4-6
ANTHROPIC_MODEL="claude-sonnet-4-6"

# ── Embeddings ────────────────────────────────────────────────
# Choose ONE provider. Set EMBEDDING_PROVIDER to "voyage" or "openai".
EMBEDDING_PROVIDER="voyage"

# Voyage AI (recommended — purpose-built for retrieval, cheaper per token)
# Get your key at dash.voyageai.com → API Keys.
VOYAGE_API_KEY="pa-your-voyage-key-here"
# Model: voyage-3 gives 1024-dim embeddings. Do not change without re-embedding corpus.
VOYAGE_MODEL="voyage-3"

# OpenAI (alternative if you prefer one provider)
# Get your key at platform.openai.com → API Keys.
OPENAI_API_KEY="sk-your-openai-key-here"
# text-embedding-3-small = 1536 dims. If switching from voyage-3, update DB schema too.
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# ── Demo org (used by seed script) ────────────────────────────
# Set to "true" to allow the seed script to run.
ALLOW_SEED="true"
